# Copy to .env (never commit .env). All variables are optional.

# Persistent locations (defaults: ./data and ./outputs relative to the repository)
AZMONITOR_DATA_DIR=
AZMONITOR_OUTPUT_DIR=

# Optional API-backed narrative generation. Leave empty for the facts-only
# fallback or an analyst-supplied narrative file. The provider/model are read
# from config/settings.yaml (narrative.api) and can be overridden here.
ANTHROPIC_API_KEY=
AZMONITOR_NARRATIVE_MODEL=

# Optional delivery destination (disabled unless configured AND enabled in settings.yaml)
AZMONITOR_DELIVERY_WEBHOOK_URL=

# Optional HTTP proxy for source downloads
HTTPS_PROXY=

# ---- Cloud worker (python -m azmonitor.jobs run) and application state
# Neon connection string: jobs, publications and the email ledger live here with the read model.
AZMONITOR_DATABASE_URL=
# "production" on the GitHub runner is decided by each job's own row; set this only for local work.
AZMONITOR_ENVIRONMENT=
# neutral: the only profile permitted to upload to personal storage.
AZMONITOR_PROFILE=neutral
# Private Blob credential (see docs/cloud-deployment.md) or, for local work, a directory store.
BLOB_READ_WRITE_TOKEN=
AZMONITOR_OBJECT_STORE_DIR=
# Test hooks for scripts/e2e/run.py only. A production job refuses to run with any of them set.
# AZMONITOR_REFRESH_DATASETS= AZMONITOR_FETCH_OVERRIDES= AZMONITOR_JOB_LEASE_SECONDS=
# AZMONITOR_HEARTBEAT_SECONDS= AZMONITOR_TEST_NOTIFICATIONS= AZMONITOR_SKIP_RESTORE=
