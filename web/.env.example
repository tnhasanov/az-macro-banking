# The dashboard's configuration. Set these in Vercel (Project → Settings → Environment Variables),
# scoped per environment as shown. Never commit real values; `.env*` files other than this one are
# ignored. docs/report-jobs.md has the full matrix and the reason for each.

# ---------------------------------------------------------------- required, Production and Preview
# Neon, pooled connection string (contains "-pooler"). Use a separate Neon branch for Preview.
AZMONITOR_DATABASE_URL=
# Signs the session cookie and unsubscribe links. openssl rand -base64 48. Different per environment.
AZMONITOR_SESSION_SECRET=
# PBKDF2 digest of the dashboard passphrase (see docs/cloud-deployment.md for how to make one).
AZMONITOR_DASHBOARD_PASSPHRASE_HASH=
# The signed-in person's address: the only address "email me" and "send this to me" ever use.
AZMONITOR_OWNER_EMAIL=

# ---------------------------------------------------------------- Production only
# Vercel sends it as "Authorization: Bearer ..." to /api/cron/tick. openssl rand -hex 32.
CRON_SECRET=
# Starting runners: a fine-grained personal access token limited to this one repository with
# "Actions: Read and write" and nothing else. The workflow (report-job.yml), repository and branch
# are fixed server-side; the browser cannot choose any of them.
GITHUB_DISPATCH_TOKEN=
GITHUB_REPOSITORY=tnhasanov/az-macro-banking
# The branch whose code the runner checks out. report-job.yml must also exist on the default branch.
GITHUB_WORKFLOW_REF=main
# Resend (https://resend.com). The sending domain must be verified; until it is, Resend's
# onboarding sender can deliver only to the Resend account's own address.
RESEND_API_KEY=
AZMONITOR_EMAIL_FROM="Azerbaijan Macro & Banking Monitor <reports@your-verified-domain>"
# From the Resend webhook you create for https://<production-domain>/api/webhooks/resend
RESEND_WEBHOOK_SECRET=
# Absolute URL used in email links, e.g. https://your-project.vercel.app
AZMONITOR_APP_URL=

# ---------------------------------------------------------------- optional
# Comma-separated session subjects allowed to change settings and force regeneration.
# Defaults to AZMONITOR_OWNER_EMAIL.
AZMONITOR_ADMIN_SUBJECTS=
# PDFs larger than this are linked instead of attached (bytes; default 10 MB, Resend's cap is 40 MB).
AZMONITOR_ATTACHMENT_LIMIT_BYTES=
# github (default in Production) | local (development only) | off (default everywhere else)
AZMONITOR_DISPATCH_MODE=
# resend (default when RESEND_API_KEY is set) | capture (development/test only) | none
AZMONITOR_EMAIL_PROVIDER=

# Blob credentials are not set here: connecting the Blob store to this project gives Production
# OIDC (VERCEL_OIDC_TOKEN + BLOB_STORE_ID), which the download route and email attachments use.
