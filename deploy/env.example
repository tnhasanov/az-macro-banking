# Copy to ../.env on the server and fill in. Never commit the result.
#
#   cp deploy/env.example .env && chmod 600 .env
#
# Everything here is either a secret or a deployment fact. Nothing here changes what the reports say;
# the analysis is configured in config/, which is committed and reviewable.
#
# The system runs with none of these set. With no credentials it collects, analyses, produces every
# report and records what it *would* have delivered, marking each as not sent and saying why. That is
# the intended state until the account side is ready.

# ---------------------------------------------------------------- paths and time
TZ=Asia/Baku
AZMONITOR_DATA_DIR=/var/lib/azmonitor/data
AZMONITOR_OUTPUT_DIR=/var/lib/azmonitor/outputs

# ------------------------------------------------------------- persistent storage
# Run before and after each scheduled task, inside the job lock. Leave both unset when the Docker
# volume is the persistent store and is backed up by the host; set them to sync to object storage.
# The whole restore-process-save cycle is one protected unit: a failed restore stops the run before
# anything is produced, and a failed save leaves the outputs on disk and reports exit code 6.
#AZMONITOR_RESTORE_CMD=aws s3 sync s3://my-bucket/azmonitor/data "$AZMONITOR_DATA_DIR" --delete
#AZMONITOR_SAVE_CMD=aws s3 sync "$AZMONITOR_DATA_DIR" s3://my-bucket/azmonitor/data && aws s3 sync "$AZMONITOR_OUTPUT_DIR" s3://my-bucket/azmonitor/outputs

# ---------------------------------------------------------------- report archive
# Where a delivered email's links resolve. Serve deploy/nginx-archive.conf behind the host's own
# authentication and put its address here. Leave unset and emails carry the attachment and name the
# other files without linking them - a dead link in a board pack is worse than no link.
#AZMONITOR_ARCHIVE_BASE_URL=https://reports.internal.example/azmonitor

# ------------------------------------------------------------------- who gets it
# The draft distribution list is owner-only. The address lives here, not in config/delivery.yaml,
# so changing who receives a report is a change of environment and not a change of code.
AZMONITOR_OWNER_EMAIL=

# WhatsApp is off in config/delivery.yaml and needs a recorded opt-in there as well as a number
# here. Both are required: a number alone sends nothing.
#AZMONITOR_OWNER_WHATSAPP=+994XXXXXXXXX

# ------------------------------------------------------- email: Microsoft Graph
# An Entra ID app registration with the *application* permission Mail.Send, admin-consented, and a
# client secret. Mail.Send as an application permission can send as any mailbox in the tenant, so
# scope it with an application access policy to the one sender below before granting it.
#AZMONITOR_GRAPH_TENANT_ID=
#AZMONITOR_GRAPH_CLIENT_ID=
#AZMONITOR_GRAPH_CLIENT_SECRET=
#AZMONITOR_GRAPH_SENDER=azmonitor@yourbank.az

# ------------------------------------------------------- WhatsApp (optional)
# Meta Cloud API. Templates must be approved before they can be sent; the names and the *order* of
# their variables are in config/delivery.yaml and must match what was registered.
#AZMONITOR_WHATSAPP_PHONE_NUMBER_ID=
#AZMONITOR_WHATSAPP_TOKEN=
# or, for the Twilio route:
#AZMONITOR_TWILIO_ACCOUNT_SID=
#AZMONITOR_TWILIO_AUTH_TOKEN=
#AZMONITOR_TWILIO_WHATSAPP_FROM=+14155238886

# --------------------------------------------------------- AI narrative (optional)
# Not needed for any report. The deterministic and analyst-authored paths produce the full deck with
# no API of any kind. Set these only to enable settings.narrative.provider=api, and note that
# config/delivery.yaml carries hard spending ceilings that stop the run and fall back to facts-only
# text rather than exceeding them.
#ANTHROPIC_API_KEY=
#AZMONITOR_NARRATIVE_MODEL=
# Current prices per million tokens, used only to enforce the ceiling - never presented as a bill.
#AZMONITOR_NARRATIVE_INPUT_PRICE=
#AZMONITOR_NARRATIVE_OUTPUT_PRICE=
