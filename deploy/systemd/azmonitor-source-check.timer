# Three checks a day, at 09:15, 13:15 and 17:15 Asia/Baku.
#
# These times are also in config/schedule.yaml, which is the copy the application reads. A timer
# cannot read YAML, so the fact is written twice; `monitor schedule check` compares the two and
# reports any drift, because the failure mode - a report that silently stops arriving - is invisible
# otherwise.

[Unit]
Description=azmonitor source checks at 09:15, 13:15 and 17:15 Asia/Baku

[Timer]
OnCalendar=*-*-* 09:15:00
OnCalendar=*-*-* 13:15:00
OnCalendar=*-*-* 17:15:00
Persistent=true
# A host that was asleep at 13:15 runs the check when it wakes, once, not three times over.
AccuracySec=1min
RandomizedDelaySec=90
Unit=azmonitor-source-check.service

[Install]
WantedBy=timers.target
